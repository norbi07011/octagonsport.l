# Zmienne środowiskowe – wpisz je w Netlify → Site configuration → Environment variables
# (NIE w tym pliku i NIE w kodzie). Po zmianie: Redeploy.

# Mollie – klucz API (Developers → API keys). Na start test_..., po zatwierdzeniu konta live_...
MOLLIE_API_KEY=

# Pełny adres sklepu, bez ukośnika na końcu (potrzebny dla powrotu z płatności i webhooka)
SITE_URL=https://www.octagonsport.nl

# (opcjonalnie) Resend – maile z potwierdzeniem zamówienia
RESEND_API_KEY=
MAIL_FROM=OctagonSportNL <shop@octagonsport.nl>
SHOP_EMAIL=shop@octagonsport.nl
